**/*credentials*.json
**/*secret*.json
**/*private*.key
**/*private*.pem
**/*.p12
**/*.jks
**/*.keystore

# Environment & Config Files
backend/.env
admin-dashboard/.env
frontend/.env
**/.env.local
**/.env.production
**/.env.development
**/local.properties

